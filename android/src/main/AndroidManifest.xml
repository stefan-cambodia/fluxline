<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- OpenGL ES 2.0 suffit ; aucun capteur n'est nécessaire. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!--
        appCategory="game" : sur Android 16+, les grands écrans ignorent le
        verrouillage d'orientation des applications, sauf pour les jeux.
        enableOnBackInvokedCallback="false" : la touche retour reste transmise
        au jeu (libGDX), qui gère lui-même pause et navigation.
    -->
    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Fluxline">

        <activity
            android:name=".android.AndroidLauncher"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorPortrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
